<UserControl x:Class="EdgeOptimizer.Settings.WinUI.Views.MacrosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:EdgeOptimizer.Settings.Core.Models">
  <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Macros" Style="{StaticResource SectionTitleStyle}"/>
          <TextBox Grid.Row="1" PlaceholderText="Search macros" Text="{Binding MacroSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,14,0,12"/>
          <ListView Grid.Row="2" ItemsSource="{Binding FilteredMacros}" SelectedItem="{Binding SelectedMacro, Mode=TwoWay}" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="Macros.List">
            <ListView.ItemTemplate><DataTemplate x:DataType="models:MacroDefinition"><Grid MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#132B3B" BorderBrush="{ThemeResource AppAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="7,3"><TextBlock Text="{x:Bind Shortcut}" Foreground="{ThemeResource AppAccentBrush}" FontSize="11"/></Border></Grid></DataTemplate></ListView.ItemTemplate>
          </ListView>
          <Button Grid.Row="3" Content="＋  New macro" Command="{Binding NewMacroCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Action sequence" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Actions execute from top to bottom." Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel>
          <ListView Grid.Row="1" ItemsSource="{Binding SelectedMacro.Steps}" Background="Transparent" BorderThickness="0" Margin="0,16,0,12">
            <ListView.ItemTemplate><DataTemplate x:DataType="models:MacroStep"><Border Style="{StaticResource InsetStyle}" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="⋮⋮" Style="{StaticResource MutedTextStyle}"/><TextBlock Grid.Column="1" Text="{x:Bind Action}"/><TextBlock Grid.Column="2" Text="{x:Bind Value}" FontWeight="SemiBold" Margin="10,0,12,0"/><Button Grid.Column="3" Content="×" Tag="{x:Bind}" Click="OnDeleteStepClick" Width="34" Height="32" AutomationProperties.Name="Delete macro step"/></Grid></Border></DataTemplate></ListView.ItemTemplate>
          </ListView>
          <Grid Grid.Row="2" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="＋  Add action" Command="{Binding AddActionCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="●  Record actions" HorizontalAlignment="Stretch" IsEnabled="False" ToolTipService.ToolTip="Recording requires the future versioned worker contract."/></Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource CardStyle}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="18"><TextBlock Text="Trigger &amp; playback" Style="{StaticResource SectionTitleStyle}"/>
          <TextBox Header="Macro name" Text="{Binding SelectedMacro.Name, Mode=TwoWay}"/>
          <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Header="Shortcut" Text="{Binding SelectedMacro.Shortcut}" IsReadOnly="True"/><Button Grid.Column="1" Content="Change" Command="{Binding ChangeShortcutCommand}" VerticalAlignment="Bottom"/></Grid>
          <StackPanel Spacing="8"><TextBlock Text="Playback mode" Style="{StaticResource MutedTextStyle}"/><RadioButton Content="Run once" IsChecked="True" GroupName="Playback"/><StackPanel Orientation="Horizontal" Spacing="10"><RadioButton Content="Repeat" GroupName="Playback"/><NumberBox Value="3" Width="74" Minimum="1" Maximum="100"/><TextBlock Text="times" VerticalAlignment="Center"/></StackPanel><RadioButton Content="Repeat until stop key" GroupName="Playback"/><CheckBox Content="Release all keys when stopped" IsChecked="True" Margin="0,8,0,0"/></StackPanel>
          <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="Saved macros are delivered to the unprivileged worker when this profile is activated."/>
          <Button Content="▷  Test macro" IsEnabled="False" ToolTipService.ToolTip="Safe test playback is not implemented yet." Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch"/>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,12"><Grid><Button Content="Delete macro" Command="{Binding DeleteMacroCommand}" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left"/><TextBlock Text="{Binding FeedbackText}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><Button Content="Duplicate" Command="{Binding DuplicateMacroCommand}"/><Button Content="Save macro" Command="{Binding SaveMacroCommand}" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Grid></Border>
  </Grid>
</UserControl>
